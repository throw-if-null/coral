{
  "name": "coral-architecture",
  "version": "0.6.0",
  "private": true,
  "description": "Coral is a set of rules for organising code in a repository, followed by coding agents and by people.",
  "scripts": {
    "test": "npm run docs:build",
    "docs:dev": "vitepress dev",
    "docs:build": "npm run check:versions && npm run check:rules && vitepress build && npm run check:anchors",
    "check:rules": "node --test scripts/*.test.mjs",
    "docs:preview": "vitepress preview",
    "check:anchors": "node scripts/check-anchors.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "build": "npm run docs:build",
    "rules:lock": "node scripts/rules-lock.mjs",
    "rules:index": "node scripts/rules-index.mjs",
    "contract:generate": "node scripts/generate-contract.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/throw-if-null/coral.git"
  },
  "keywords": [],
  "author": "Mirza Merdovic",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/throw-if-null/coral/issues"
  },
  "homepage": "https://coral.appsandtools.work",
  "devDependencies": {
    "mermaid": "^11.17.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "wrangler": "4.152.0",
    "yaml": "^2.9.0"
  }
}
